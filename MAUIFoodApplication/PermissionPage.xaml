<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUIFoodApplication.PermissionPage"
             Title="PermissionPage">
    <VerticalStackLayout>
        <Label Text="Permission Demo" FontSize="32" HorizontalOptions="Center" />
        <Label x:Name="ResultLabel" FontSize="18" TextColor="DarkBlue" />
        <Button Text="Check Location Permission" Clicked="OnCheckPermissionClicked" Margin="0,0,0,10" />
        <Button Text="Check Camera Permission" Clicked="OnCheckCameraPermissionClicked" Margin="0,0,0,10" />
        <Button Text="Check Storage Permission" Clicked="OnCheckStoragePermissionClicked" Margin="0,0,0,10" />
        <Button Text="Check Microphone Permission" Clicked="OnCheckMicrophonePermissionClicked" Margin="0,0,0,10" />
        <Button Text="Check Contacts Permission" Clicked="OnCheckContactsPermissionClicked" Margin="0,0,0,10" />

    </VerticalStackLayout>
</ContentPage>