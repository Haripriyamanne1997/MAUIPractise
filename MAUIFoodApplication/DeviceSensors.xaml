<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUIFoodApplication.DeviceSensors"
             Title="DeviceSensors">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Accelerometer -->
            <Label Text="Accelerometer" FontAttributes="Bold" />
            <Label x:Name="AccelerometerLabel" Text="Waiting..." FontSize="16" />
            <Button Text="Start Accelerometer" Clicked="OnStartAccelerometerClicked" />
            <Button Text="Stop Accelerometer" Clicked="OnStopAccelerometerClicked" />

            <!-- Gyroscope -->
            <Label Text="Gyroscope" FontAttributes="Bold" />
            <Label x:Name="GyroscopeLabel" Text="Waiting..." FontSize="16" />
            <Button Text="Start Gyroscope" Clicked="OnStartGyroscopeClicked" />
            <Button Text="Stop Gyroscope" Clicked="OnStopGyroscopeClicked" />

            <!-- Compass -->
            <Label Text="Compass" FontAttributes="Bold" />
            <Label x:Name="CompassLabel" Text="Waiting..." FontSize="16" />
            <Button Text="Start Compass" Clicked="OnStartCompassClicked" />
            <Button Text="Stop Compass" Clicked="OnStopCompassClicked" />

            <!-- Magnetometer -->
            <Label Text="Magnetometer" FontAttributes="Bold" />
            <Label x:Name="MagnetometerLabel" Text="Waiting..." FontSize="16" />
            <Button Text="Start Magnetometer" Clicked="OnStartMagnetometerClicked" />
            <Button Text="Stop Magnetometer" Clicked="OnStopMagnetometerClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
