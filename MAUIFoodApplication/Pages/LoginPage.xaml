<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUIFoodApplication.Pages.LoginPage"
             Title="Login">

    <ScrollView>
        <VerticalStackLayout Padding="30,50" Spacing="30">

            <!-- Welcome Text -->
            <Label Text="Welcome to MAUI Food Application 🍽️"
                   FontSize="28"
                   FontFamily="Poppins"
                   TextColor="#ffb452"
                   HorizontalOptions="Center" />

            <!-- Card-style Frame -->
            <Frame BackgroundColor="#f9f9f9"
                   CornerRadius="20"
                   Padding="20"
                   HasShadow="True">

                <VerticalStackLayout Spacing="15">

                    <Label Text="Sign In"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#444" />

                    <!-- Email Entry -->
                    <Frame CornerRadius="10"
                           BackgroundColor="#eee"
                           Padding="10"
                           HasShadow="False"
                           BorderColor="LightGray">
                        <Entry x:Name="EmailEntry"
                               Placeholder="Enter your email"
                               Keyboard="Email"
                               BackgroundColor="Transparent"
                               TextColor="Black" />
                    </Frame>

                    <!-- Password Entry -->
                    <Frame CornerRadius="10"
                           BackgroundColor="#eee"
                           Padding="10"
                           HasShadow="False"
                           BorderColor="LightGray">
                        <Entry x:Name="PasswordEntry"
                               Placeholder="Enter your password"
                               IsPassword="True"
                               BackgroundColor="Transparent"
                               TextColor="Black" />
                    </Frame>

                    <!-- Login Button -->
                    <Button Text="Login"
                            Clicked="OnLoginClicked"
                            BackgroundColor="#ffb452"
                            TextColor="White"
                            CornerRadius="12"
                            FontSize="16"
                            HeightRequest="50" />

                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
