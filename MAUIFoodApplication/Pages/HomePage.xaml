<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MAUIFoodApplication.Models"
             x:Class="MAUIFoodApplication.Pages.HomePage"
             Title="HomePage">

    <ContentPage.Resources>
        <Style x:Key="BadgeStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="Red"/>
            <Setter Property="StrokeShape">
                <Setter.Value>
                    <RoundRectangle CornerRadius="10"/>
                </Setter.Value>
            </Setter>
            <Setter Property="HeightRequest" Value="20"/>
            <Setter Property="WidthRequest" Value="20"/>
            <Setter Property="HorizontalOptions" Value="End"/>
            <Setter Property="VerticalOptions" Value="Start"/>
        </Style>
    </ContentPage.Resources>

    <VerticalStackLayout>

        <!-- Top Bar with Cart Icon -->
        <Grid BackgroundColor="Purple" Padding="10" ColumnDefinitions="*,Auto">
            <Label Text="Order Food"
                   TextColor="White"
                   FontSize="24"
                   HorizontalOptions="Start"
                   VerticalOptions="Center" />

            <Grid>
                <ImageButton Source="cart.png"
                             Clicked="OnCartClicked"
                             BackgroundColor="Transparent"
                             HeightRequest="30"
                             WidthRequest="30"
                             HorizontalOptions="End"
                             VerticalOptions="Center"/>

                <Border Style="{StaticResource BadgeStyle}"
                        IsVisible="{Binding CartCount, Converter={StaticResource ZeroToFalseConverter}}"
                        TranslationX="10"
                        TranslationY="-5">
                    <Label Text="{Binding CartCount}"
                           TextColor="White"
                           FontSize="12"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"/>
                </Border>
            </Grid>
        </Grid>

        <!-- Food List -->
        <CollectionView ItemsSource="{Binding FoodItems}" Margin="10">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame CornerRadius="15" Padding="10" Margin="5" HasShadow="True" BackgroundColor="White">
                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">

                            <!-- Food Image -->
                            <Image Source="{Binding ImageUrl}"
                                   WidthRequest="90"
                                   HeightRequest="90"
                                   Aspect="AspectFill"
                                   Grid.RowSpan="2"
                                   Margin="5">
                                <Image.Clip>
                                    <PathGeometry>
                                        <PathGeometry.Figures>
                                            <PathFigure StartPoint="0,15">
                                                <ArcSegment Point="0,0" Size="15,15" SweepDirection="Clockwise" />
                                                <LineSegment Point="90,0" />
                                                <ArcSegment Point="90,15" Size="15,15" SweepDirection="Clockwise" />
                                                <LineSegment Point="90,90" />
                                                <ArcSegment Point="75,90" Size="15,15" SweepDirection="Clockwise" />
                                                <LineSegment Point="15,90" />
                                                <ArcSegment Point="0,75" Size="15,15" SweepDirection="Clockwise" />
                                                <LineSegment Point="0,15" />
                                            </PathFigure>
                                        </PathGeometry.Figures>
                                    </PathGeometry>
                                </Image.Clip>
                            </Image>

                            <!-- Name -->
                            <Label Text="{Binding Name}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="Black"
                                   Grid.Column="1"
                                   VerticalOptions="Start"
                                   LineBreakMode="TailTruncation" />

                            <!-- Favorite -->
                            <ImageButton Source="{Binding FavoriteIcon}"
                                         WidthRequest="30"
                                         HeightRequest="30"
                                         Grid.Column="2"
                                         BackgroundColor="Transparent"
                                         BorderWidth="0"
                                         Padding="0"
                                         HorizontalOptions="End"
                                         VerticalOptions="Start"
                                         Clicked="OnFavoriteClicked" />

                            <!-- Price + Quantity/Cart -->
                            <StackLayout Orientation="Horizontal"
                                         Grid.Column="1"
                                         Grid.Row="1"
                                         Spacing="10"
                                         VerticalOptions="End"
                                         Padding="0,10,0,0">

                                <Label Text="{Binding Price, StringFormat='₹{0:F2}'}"
                                       FontSize="16"
                                       TextColor="Green"
                                       VerticalOptions="Center" />

                                <!-- Quantity Control -->
                                <StackLayout Orientation="Horizontal" Spacing="5" VerticalOptions="Center">
                                    <Button Text="−" WidthRequest="40" Clicked="OnDecreaseClicked" BindingContext="{Binding .}" />
                                    <Label Text="{Binding Quantity}" FontSize="16" VerticalOptions="Center" />
                                    <Button Text="+" WidthRequest="40" Clicked="OnIncreaseClicked" BindingContext="{Binding .}" />
                                </StackLayout>

                                <!-- Add to Cart -->
                                <Button Text="🛒"
                                BackgroundColor="LightBlue"
                                TextColor="black"
                                CornerRadius="10"
                                Padding="5"
                                Clicked="OnAddToCartClicked" />

                            </StackLayout>

                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
