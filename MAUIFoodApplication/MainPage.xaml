<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MAUIFoodApplication"
             x:Class="MAUIFoodApplication.MainPage"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,50"
            Spacing="30">

            

            <!-- Welcome Text -->
            <Label Text="Welcome to MAUI Food Application 🍽️"
                   FontSize="28"
                   FontFamily="Poppins"
                   TextColor="#ffb452"
                   HorizontalOptions="Center" />
   
            
            <!-- Card-style Frame -->
            <Frame BackgroundColor="#f9f9f9"
                   CornerRadius="20"
                   Padding="20"
                   HasShadow="True">

                <VerticalStackLayout Spacing="15">

                    <!-- Register Button -->
                    <Button Text="Don't have an account? Register"
                            BackgroundColor="Transparent"
                            TextColor="#512BD4"
                            FontAttributes="Bold"
                            Clicked="OnRegisterClicked" />

                    <!--<local:NativeLabel FontSize="20" TextColor="Blue" />
                    --><!-- Device Label --><!--
                    <Label x:Name="DeviceLabel"
                        Text="Loading..."
                        FontSize="22"
                        FontFamily="Poppins"
                        TextColor="Gray"
                        HorizontalOptions="Center" />-->       
                </VerticalStackLayout>

            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
